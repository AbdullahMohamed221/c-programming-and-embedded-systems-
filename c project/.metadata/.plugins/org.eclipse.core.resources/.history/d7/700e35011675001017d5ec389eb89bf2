void addStudent(const struct student *const ptr) {
	struct node *currunt = NULL;
	struct node *link = (struct node*) malloc(sizeof(struct node));
	if (link == NULL) {
		printf("\nERROR:memory allocation fails\n");
		return;
	} //checks for the success of the memory allocation
	link->data.age = ptr->age;	//allocating the age in the heap
	link->data.gpa = ptr->gpa;	//allocating the gpa in the heap
	link->data.id = ptr->id;		//allocating the id in the heap
	strcpy(link->data.name, ptr->name);	//allocating the name in the heap
	currunt = head;
	if (head == NULL) {	//checking if the list is empty or not
		link->next = (struct student*) head;
		head = link;
		return;
	}

	while (currunt->next != NULL) {	//looping till it reaches the end of the list
		if (link->data.id == currunt->data.id) {
			printf(
					"\nERROR: this id is used, this student can't be added to the system\n");
			return;
		}
		currunt = (struct node*) currunt->next;
	}
	currunt->next = (struct student*) link; //putting the node at the end of the list
	link->next = NULL;

	currunt = head;

}

void displayStudents(void) {
