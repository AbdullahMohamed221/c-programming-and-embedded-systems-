			scanf("%d", &(id_new));
			printf("GPA:");
			fflush(stdout);
			scanf("%f", &(gpa));
			printf("\n--------------\n");

			while (currunt_2->next != NULL) {//looping till it reaches the end of the list
				if (id_new == currunt_2->data.id) {
					printf(
							"\nERROR: this id is used, this student can't be added to the system\n");

					return;
				}
				currunt_2 = (struct node*) currunt_2->next;
			}

			currunt->data.age = age;
			currunt->data.gpa = gpa;
			currunt->data.id = id_new;
			strcpy(currunt->data.name, name);
			return;
		}
		currunt = (struct node*) currunt->next;
		return;
	}

	printf("\nStudent is not found\n");
	return;

}

float calculateAverageGPA(void) {
	struct node *currunt = NULL;
	int counter = 0;
	float sum = 0;
	if (head == NULL) {
		printf("the list is empty");
		return 0.0;
	}
	currunt = head;
	while (currunt != NULL) {
		sum += currunt->data.gpa;
		counter++;
		currunt = (struct node*) currunt->next;
	}
	return (sum / counter);
}

