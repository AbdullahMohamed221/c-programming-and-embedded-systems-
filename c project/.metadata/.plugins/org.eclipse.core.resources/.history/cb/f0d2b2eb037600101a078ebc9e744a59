float calculateAverageGPA(void) {
	struct node *currunt = NULL;
	int counter = 0;
	float sum = 0;
	if (head == NULL) {
		printf("the list is empty");
		return 0.0;
	}
	currunt = head;
	while (currunt != NULL) {
		sum += currunt->data.gpa;
		counter++;
		currunt = currunt->next;
	}
	return (sum / counter);
}

void searchHighestGPA(void) {
	struct node *currunt = NULL;
	float max = 0;
	int id = 0, age = 0;
	char name[50];
	if (head == NULL) {
		printf("the list is empty");
		return;
	}
	currunt = head;
	while (currunt != NULL) {
		if (max < currunt->data.gpa) {
			max = currunt->data.gpa;
			id = currunt->data.id;
			age = currunt->data.age;
			strcpy(name, currunt->data.name);

		}
		currunt = currunt->next;

	}
	printf("\n--------------\n");
	printf("\nStudent with the max GPA is:\n");
	printf("NAME:%s\n", name);
	printf("AGE:%d\n", age);
	printf("ID:%d\n", id);
	printf("GPA:%.3f\n", max);
	printf("\n--------------\n");
}
void deleteStudent(int id) {
	struct node *currunt = NULL;
	struct node *prev = NULL;
	struct node *delete = NULL;
	if (head == NULL) {
		return;
	}
	currunt = head->next;
	prev = head;
	if (head->data.id == id) {
		delete = head;
		free(delete);
		return;
	}
	while (currunt != NULL) {
		if (currunt->data.id == id) {
			delete = currunt;
			prev->next = currunt->next;
			free(delete);
			printf("\nthe student information is deleted from the system\n");
			return;
		}
		currunt = currunt->next;
		prev = prev->next;
	}
	printf("\nStudent wasn't found\n");
}
